# Shared secret for POST /api/revalidate. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Optional. Raises the GitHub API limit from 60 to 5000 requests/hour.
# A fine-grained token with no scopes (public repo read) is enough.
GITHUB_TOKEN=

# Public URL of the deployed site, used for Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=https://eggcentric-game.com
